# GEMINI_API_KEY: Required for live Gemini AI API curriculum & quiz generation.
# On Render: Add this key under Web Service > Environment > Environment Variables.
# Also accepts GOOGLE_API_KEY, GOOGLE_GENAI_API_KEY, or VITE_GEMINI_API_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://your-service.onrender.com)
APP_URL="MY_APP_URL"

# PORT: The port the server listens on (Render automatically injects PORT=10000)
# PORT=3000
